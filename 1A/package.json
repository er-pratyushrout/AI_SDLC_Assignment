{
  "name": "ai-pdf-summarizer",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace server",
    "test:e2e": "playwright test --project=chromium --project=mobile-chromium",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint client server",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=26 <27"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
