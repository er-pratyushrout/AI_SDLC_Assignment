{
  "name": "pdf-document-chat",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspaces --if-present",
    "test:frontend": "npm run test --workspace frontend",
    "test:backend": "npm run test --workspace backend",
    "lint": "eslint frontend backend",
    "format": "prettier --write \"frontend/**/*.{js,jsx,json,css,html}\" \"backend/**/*.{js,json}\" \"package.json\" \"eslint.config.js\" \".prettierrc.json\"",
    "format:check": "prettier --check \"frontend/**/*.{js,jsx,json,css,html}\" \"backend/**/*.{js,json}\" \"package.json\" \"eslint.config.js\" \".prettierrc.json\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
